{
  "name": "nuxt-shade-kit",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Nuxt 4 + Tailwind CSS v4 + shadcn-vue 的现代全栈模板项目，集成 OAuth 认证、接口安全防护、统一 UI 体系",
  "keywords": [
    "authentication",
    "boilerplate",
    "fullstack",
    "nuxt",
    "nuxt-auth-utils",
    "nuxt-security",
    "nuxt4",
    "oauth",
    "shadcn-vue",
    "starter",
    "tailwindcss",
    "template",
    "typescript",
    "vue3"
  ],
  "license": "MIT",
  "author": "Hu.Sir",
  "repository": {
    "type": "git",
    "url": "https://github.com/hujix/NuxtShadeKit"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint --fix && oxfmt",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=nuxt-shade-kit"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@nuxtjs/i18n": "10.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "consola": "3.4.2",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.0",
    "nuxt-auth-utils": "0.5.29",
    "nuxt-security": "^2.6.0",
    "postgres": "^3.4.9",
    "reka-ui": "^2.10.1",
    "shadcn-nuxt": "^2.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "ulid": "3.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "husky": "9.1.7",
    "lint-staged": "^17.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,vue,ts}": "pnpm run lint"
  },
  "packageManager": "pnpm@11.15.1",
  "onlyBuiltDependencies": [
    "@parcel/watcher",
    "esbuild",
    "unrs-resolver",
    "vue-demi"
  ]
}
